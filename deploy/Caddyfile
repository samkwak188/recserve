{
    admin localhost:2019
    http_port 8080
    https_port 8443
    servers {
        timeouts {
            read_header 5s
            read_body 5s
            write 10s
            idle 30s
        }
    }
}

{$APP_HOSTNAME} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
    @internal path /internal/* /openapi.json /docs /redoc /v1/*
    handle @internal {
        respond 404
    }
    @backend path /api/* /auth/* /healthz /readyz
    handle @backend {
        request_body {
            max_size 32KB
        }
        import /etc/recserve/upstream.caddy
    }
    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
