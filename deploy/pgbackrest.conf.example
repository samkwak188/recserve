[global]
repo1-type=s3
repo1-path=/recserve
repo1-s3-endpoint=REPLACE_WITH_B2_S3_ENDPOINT_WITHOUT_SCHEME
repo1-s3-region=REPLACE_WITH_REGION
repo1-s3-bucket=REPLACE_WITH_BUCKET
repo1-s3-key=REPLACE_WITH_SCOPED_KEY_ID
repo1-s3-key-secret=REPLACE_WITH_SCOPED_SECRET
repo1-s3-uri-style=path
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_SEPARATELY_STORED_RANDOM_PASSPHRASE
repo1-retention-full=7
repo1-retention-full-type=count
repo1-retention-history=7
compress-type=zst
process-max=1
start-fast=y
archive-timeout=60
log-level-console=warn
log-level-file=off
lock-path=/tmp/pgbackrest

[recserve]
pg1-path=/var/lib/postgresql/data
pg1-user=recserve_owner
pg1-database=recserve
